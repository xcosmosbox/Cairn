  "original_annotations": [
    {
      "skill": "public-synthetic-queue",
      "file_path": "references/queue.md",
      "items": [
        {
          "id": "public-synthetic-queue-entity-容量为8的阻塞队列",
          "tag": "entity",
          "name": "容量为8的阻塞队列",
          "content": "文档描述的虚构阻塞队列，容量为 8；满时生产者等待，空时消费者等待。",
          "detail": "该实体是文档中描述的虚构阻塞队列，容量为 8。它是有界队列：当队列已满时，生产者不能继续入队而进入等待；当队列为空时，消费者不能继续出队而进入等待。这解释了阻塞队列的基本含义，并对应英文描述 Bounded queue blocks when full or empty。",
          "confidence": 0.95
        },
        {
          "id": "public-synthetic-queue-concept-有界队列阻塞规则",
          "tag": "concept",
          "name": "有界队列阻塞规则",
          "content": "有界队列在满时阻塞生产者、空时阻塞消费者的行为规则。",
          "detail": "有界队列阻塞规则指：当有界队列达到容量上限（本文为 8）时，生产者需要等待；当队列为空时，消费者需要等待。该规则解释了阻塞队列的基本含义，英文表述为 Bounded queue blocks when full or empty。",
          "confidence": 0.9
        },
        {
          "id": "public-synthetic-queue-entity-生产者",
          "tag": "entity",
          "name": "生产者",
